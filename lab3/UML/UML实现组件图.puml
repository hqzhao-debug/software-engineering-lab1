@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 8
skinparam componentBackgroundColor #F1F8F8
skinparam componentBorderColor #347E80
skinparam ArrowColor #526878
skinparam noteBackgroundColor #FFF7E6
skinparam noteBorderColor #D4AD66
skinparam linetype polyline
title 实验三实现组件图：浏览器图形界面与 Python 服务
top to bottom direction

actor "本机操作者\n游客／普通用户／管理员" as User
component "浏览器图形界面 web/\n商品卡片／表单／交易／管理" as GUI
component "本地 HTTP 适配 webapp.py\n127.0.0.1／Origin／CSRF／HttpOnly Cookie" as HTTP
component "命令行界面 cli.py\nargparse 命令、中文提示、JSON 输出" as CLI
component "会话文件 SessionStore\n令牌保存为仅本人可读文件" as Session
component "Market 服务入口\nservice.py" as Market
package "业务服务模块" {
  component "账号 accounts.py\n注册／验证／登录／建管理员" as Account
  component "商品 products.py\n私人草稿／提交版本／查询／图片" as Product
  component "交易 trades.py\n预约／确认／拒绝／取消／完成" as Trade
  component "管理 admin.py\n审核／违规／封禁／日志／统计" as Admin
}
component "事务、安全与幂等 base.py\n会话重验／权限／审计／统一提交" as Base
component "SQLite schema 与连接 db.py\n外键／唯一索引／不可变历史触发器" as Storage
database "SQLite 本地数据库\nWAL + synchronous=FULL\n账号／会话／商品／提交／预约\n图片 BLOB／限制／幂等／审计" as DB
folder "本地 outbox 验证邮件\n开发演示适配器" as Outbox
cloud "SMTP_SSL 注册验证邮件\n需显式配置并实际部署验证" as SMTP
component "unittest 自动化测试\n临时数据库／受控时钟／并发连接" as Tests

User --> CLI
User --> GUI
GUI --> HTTP : 同源 JSON 请求与图片
HTTP --> Market : Cookie 身份 + 已校验参数
CLI --> Session : 读取本角色令牌
CLI --> Market : 当前身份 + 命令参数
Market --> Account
Market --> Product
Market --> Trade
Market --> Admin
Account --> Base
Product --> Base
Trade --> Base
Admin --> Base
Base --> Storage
Storage --> DB
Account --> Outbox : local 模式
Account --> SMTP : smtp 模式
Tests --> Market : 同一业务入口

note right of DB
  同一商品最多一条有效预约、最多一条完成交易：
  两条按状态过滤的 UNIQUE 索引。
  不可变已提交版本、预约快照、审计日志：
  由数据库触发器额外保护。
end note
note bottom of HTTP
  图形界面与命令行复用同一业务服务。
  原 PostgreSQL 改为本地 SQLite。
  独立演示数据；不替代真实多人易用性验收。
  本机文件访问者属于可信部署边界。
end note
note bottom of Outbox
  开发邮件可复现实验流程，不能证明真实邮箱归属。
  实际校园邮箱域名尚需配置，默认 campus.example。
end note
@enduml
