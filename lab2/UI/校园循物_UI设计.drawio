okeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Hiragino Sans GB;fontSize=13;fontColor=#147D72;spacing=0;" vertex="1" parent="1"><mxGeometry x="873" y="376" width="64.0" height="25" as="geometry" /></mxCell><mxCell id="p9-58" value="封禁将立即使现有登录失效。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Hiragino Sans GB;fontSize=16;fontColor=#14343F;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="422" width="220.0" height="28" as="geometry" /></mxCell><mxCell id="p9-59" value="封禁原因 *" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Hiragino Sans GB;fontSize=14;fontColor=#657C84;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="474" width="77.5" height="26" as="geometry" /></mxCell><mxCell id="p9-60" value="" style="rounded=1;arcSize=7;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#DBE5E8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="862" y="502" width="510" height="90" as="geometry" /></mxCell><mxCell id="p9-61" value="多次提交违反固定禁止规则的商品。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Hiragino Sans GB;fontSize=16;fontColor=#14343F;spacing=0;" vertex="1" parent="1"><mxGeometry x="876" y="514" width="268.0" height="28" as="geometry" /></mxCell><mxCell id="p9-62" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=0;fillColor=#FFF4DF;strokeColor=#FFF4DF;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="862" y="626" width="510" height="100" as="geometry" /></mxCell><mxCell id="p9-63" value="关联处理" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Hiragino Sans GB;fontSize=16;fontColor=#AC6B16;spacing=0;" vertex="1" parent="1"><mxGeometry x="880" y="639" width="76.0" height="28" as="geometry" /></mxCell><mxCell id="p9-64" value="取消该账号作为买家或卖家的全部有效预约。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Hiragino Sans GB;fontSize=13;fontColor=#AC6B16;spacing=0;" vertex="1" parent="1"><mxGeometry x="880" y="669" width="272.0" height="25" as="geometry" /></mxCell><mxCell id="p9-65" value="其未成交非草稿商品下架，私人草稿保留。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Hiragino Sans GB;fontSize=13;fontColor=#AC6B16;spacing=0;" vertex="1" parent="1"><mxGeometry x="880" y="693" width="259.0" height="25" as="geometry" /></mxCell><mxCell id="p9-66" value="" style="rounded=1;arcSize=17;whiteSpace=wrap;html=0;fillColor=#FCEDEB;strokeColor=#FCEDEB;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="862" y="755" width="245" height="42" as="geometry" /></mxCell><mxCell id="p9-67" value="封禁账号" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Hiragino Sans GB;fontSize=15;fontColor=#B14E47;spacing=0;" vertex="1" parent="1"><mxGeometry x="954.5" y="764" width="72.0" height="27" as="geometry" /></mxCell><mxCell id="p9-68" value="" style="rounded=1;arcSize=17;whiteSpace=wrap;html=0;fillColor=#EEF3F5;strokeColor=#EEF3F5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1127" y="755" width="245" height="42" as="geometry" /></mxCell><mxCell id="p9-69" value="解除封禁" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Hiragino Sans GB;fontSize=15;fontColor=#9AAEB5;spacing=0;" vertex="1" parent="1"><mxGeometry x="1219.5" y="764" width="72.0" height="27" as="geometry" /></mxCell><mxCell id="p9-70" value="已封禁账号显示“解除封禁”，由管理员手动解除。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Hiragino Sans GB;fontSize=13;fontColor=#657C84;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="831" width="311.0" 